BIRDEYE_API_KEY=your_api_key_here

# Solana only for this strategy.
CHAIN=solana

# Free Standard package is documented at 1 request/sec.
# 1.5 spacing is used because a 5-minute live run showed Birdeye 429ing
# every second request at 1.15s (phase-locked just under its real window).
API_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Discovery / polling.
DISCOVERY_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=30
CANDIDATE_LIMIT=10
MAX_WATCHED_TOKENS=3

# Early-token universe.
MIN_MARKET_CAP_USD=60000
MAX_MARKET_CAP_USD=3000000
MIN_LIQUIDITY_USD=10000
MAX_TOKEN_AGE_HOURS=24
# token_creation_info is Lite/Starter+, not free Standard. When it is
# inaccessible the age is "unknown": AGE_STRICT=false allows the token
# with a warning, AGE_STRICT=true rejects it.
ENFORCE_TOKEN_AGE=true
AGE_STRICT=false
MAX_PRICE_CHANGE_24H_PERCENT=80

# Smart-money proxy. Birdeye documents these Solana wallet_tags values:
# dev, bundler, sniper, insider, smart_trader.
TOP_TRADERS_LIMIT=10
SMART_TAGS=smart_trader
MIN_SMART_WALLETS=2
MIN_SMART_BUY_RATIO=0.60

# 15m CVD.
CVD_WINDOW_SECONDS=900
CVD_MIN_BUY_SELL_RATIO=1.20

# Paper-position lifecycle only.
STOP_LOSS_PERCENT=15
TAKE_PROFIT_PERCENT=50
MAX_HOLD_SECONDS=2400
# Consecutive bearish-CVD polls before a paper exit fires (whipsaw guard).
BEARISH_EXIT_CONFIRMATIONS=2
