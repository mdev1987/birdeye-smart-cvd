BIRDEYE_API_KEY=your_api_key_here

# Solana only for this strategy.
CHAIN=solana

# Free Standard package is documented at 1 request/sec.
# 1.5 spacing is used because a 5-minute live run showed Birdeye 429ing
# every second request at 1.15s (phase-locked just under its real window).
API_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Research mode: core | risk | enriched (default enriched = full pipeline).
#   CORE     = Birdeye trending/overview/top-traders/trades + proxy + CVD only.
#              Cheapest on the 1-RPS tier; tests the raw hypothesis first.
#   RISK     = CORE + RugCheck + Helius.
#   ENRICHED = RISK + Jupiter + DexScreener + CabalSpy.
# Telegram alerting is orthogonal and fires in every mode when configured.
SCANNER_MODE=enriched

# Discovery / polling.
# Trending is paged (25 CU/page whatever the size, ~1000 ranked): rows are
# pre-filtered on their native marketcap/fdv + liquidity + 24h% fields and
# only survivors pay for overview + enrichment. The 24H interval matches
# the Early Meme playbook timeframe.
DISCOVERY_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=30
CANDIDATE_LIMIT=100
# When Birdeye reports CU exhaustion, discovery pauses this long instead
# of burning metered calls that all fail (0 disables; 1800 = 30 min).
CU_COOLDOWN_SECONDS=1800
TRENDING_PAGE_SIZE=50
TRENDING_MAX_PAGES=2
TRENDING_INTERVAL=24h
MAX_WATCHED_TOKENS=3
# Second discovery source: fresh listings (Standard, 20 CU/request).
# Rows carry liquidity + ISO listing time but no marketcap: they pre-gate
# on those and are judged on size at the overview stage. Skipped when
# trending already filled the watchlist. MEME_PLATFORMS adds pump.fun
# venues (Solana only; default off = classic pools first).
NEWLISTING_ENABLED=true
NEWLISTING_LIMIT=20
NEWLISTING_MEME_PLATFORMS=false

# Early-token universe.
MIN_MARKET_CAP_USD=60000
MAX_MARKET_CAP_USD=3000000
MIN_LIQUIDITY_USD=10000
MAX_TOKEN_AGE_HOURS=24
# token_creation_info is Lite/Starter+, not free Standard. When it is
# inaccessible the age is "unknown": AGE_STRICT=false allows the token
# with a warning, AGE_STRICT=true rejects it.
ENFORCE_TOKEN_AGE=true
AGE_STRICT=false
MAX_PRICE_CHANGE_24H_PERCENT=80

# Smart-money proxy (free-tier stand-in for Birdeye's paid Smart Money feed).
# dev, bundler, sniper, insider, smart_trader.
TOP_TRADERS_LIMIT=10
SMART_TAGS=smart_trader
MIN_SMART_WALLETS=2
MIN_SMART_BUY_RATIO=0.60

# 15m CVD. The volume/trade floors reject thin "$2 buy / $0 sells" windows
# whose ratio is infinite but meaningless. Research params: validate on history.
CVD_WINDOW_SECONDS=900
CVD_MIN_BUY_SELL_RATIO=1.20
CVD_MIN_VOLUME_USD=2000
CVD_MIN_TRADES=10

# Paper-position lifecycle: scale-out ladder + profit protection.
# Playbook Early Meme risk rules (50% at x2, 30% at x3, 20% moonbag):
# TP1 banks TP1_FRACTION at +TAKE_PROFIT_PERCENT, TP2 banks TP2_FRACTION
# of the remainder at +TAKE_PROFIT2_PCT, the rest rides to bearish/SL/TTL
# exits. Paper size is 1% of start balance per the playbook (10/1000).
STOP_LOSS_PERCENT=15
TAKE_PROFIT_PERCENT=100
TAKE_PROFIT2_PCT=200
TP1_FRACTION=0.5
TP2_FRACTION=0.6
# Trailing lock: once pnl >= TRAIL_ARM_PCT, exit the runner if price falls
# TRAIL_STOP_PCT below its post-entry peak. Wide on purpose so moonbag
# runners survive normal pullbacks; TRAIL_STOP_PCT=0 disables.
TRAIL_ARM_PCT=50
TRAIL_STOP_PCT=40
# "Exit immediately if volume dies": exit after this many consecutive polls
# with zero new trades. 0 disables.
VOLUME_DEATH_QUIET_POLLS=6
# Chase guard: skip BUY when live price exceeds the discovery snapshot by
# more than this (flat is the entry, never FOMO the breakout). 0 disables.
ENTRY_MAX_SURGE_PCT=30
MAX_HOLD_SECONDS=2400
# Consecutive bearish-CVD polls before a paper exit fires (whipsaw guard).
BEARISH_EXIT_CONFIRMATIONS=2

# Free keyless enrichment (own polite spacing, outside Birdeye CU budget).
# DexScreener: pool ages (pairCreatedAt) + overview-gap filling.
DEXSCREENER_ENABLED=true
DEXSCREENER_MIN_REQUEST_INTERVAL_SECONDS=0.3
# Jupiter lite Price v3: token-level createdAt age oracle + price fallback.
JUPITER_ENABLED=true
JUPITER_MIN_REQUEST_INTERVAL_SECONDS=0.5

# RugCheck pre-entry veto (free summary endpoint).
RUGCHECK_ENABLED=true
RUGCHECK_MAX_SCORE=50
RUGCHECK_REJECT_DANGER=true
# RUGCHECK_STRICT=true rejects tokens with no report; false allows them.
RUGCHECK_STRICT=false
RUGCHECK_MIN_REQUEST_INTERVAL_SECONDS=0.4

# Optional CabalSpy cluster confirmation. Inert unless a key is set.
CABALSPY_API_KEY=
CABALSPY_ENABLED=true
CABALSPY_MIN_WALLETS=3
# CABALSPY_REQUIRE_CLUSTER=true blocks entries without a cluster.
CABALSPY_REQUIRE_CLUSTER=false
CABALSPY_MIN_REQUEST_INTERVAL_SECONDS=1.0

# Simulate-only Jupiter execution checks (ENRICHED mode only).
# Quote + assemble + local sign + simulateTransaction, NEVER broadcast:
# jupsim.py has no execute/send path by construction. PRIVATE_KEY should be
# a THROWAWAY keypair (it only signs locally for the simulator; no funds
# needed, nothing that moves funds ever leaves the machine). Inert unless
# PRIVATE_KEY is set; advisory-only unless SIM_REQUIRE_ROUTE=true.
SIM_ENABLED=true
JUPITER_API_KEY=
# Swap v2 /order host (the Lite price host is separate and stays keyless).
JUPITER_BASE_URL=https://api.jup.ag
PRIVATE_KEY=
JUPITER_ORDER_TIMEOUT_S=12
# Sells quote with explicit slippage (buys use Jupiter RTSE routing).
SIM_SLIPPAGE_BPS=300
# Impact above this is flagged on the alert (advisory, never blocks).
SIM_MAX_IMPACT_PCT=5
# SIM_REQUIRE_ROUTE=true skips entries with no Jupiter route (unsellable).
SIM_REQUIRE_ROUTE=false

# Helius RPC + transfers (holder concentration, on-chain buy proof).
# Inert unless HELIUS_API_KEY is set. Prefer the key var below over
# embedding ?api-key= in URLs (URLs end up in logs and process lists).
HELIUS_API_KEY=
HELIUS_ENABLED=true
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_MIN_REQUEST_INTERVAL_SECONDS=0.3
HELIUS_TOP10_MAX_PCT=60
# HELIUS_REJECT_CONCENTRATION=true vetoes entries above the threshold.
HELIUS_REJECT_CONCENTRATION=false
# Verify tagged smart wallets actually bought (advisory helius=N/M log).
HELIUS_VERIFY_WALLETS=true
# HELIUS_REQUIRE_CONFIRMED=true blocks entries with zero confirmed buys.
HELIUS_REQUIRE_CONFIRMED=false
HELIUS_VERIFY_WINDOW_HOURS=24
HELIUS_VERIFY_LIMIT=10

# Telegram paper alerts (python-telegram-bot + telegramify-markdown).
# Inert unless BOTH are set. Talk to @BotFather for the token, message
# the bot once, then get the chat id via getUpdates.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper portfolio: cash accounting behind open/close alerts.
# 1% risk per the Early Meme playbook (10 on a 1000 start balance).
PAPER_START_BALANCE_USD=1000
PAPER_POSITION_SIZE_USD=10
MAX_OPEN_POSITIONS=3
