BIRDEYE_API_KEY=your_api_key_here

# Solana only for this strategy.
CHAIN=solana

# Free Standard package is documented at 1 request/sec.
# 1.5 spacing is used because a 5-minute live run showed Birdeye 429ing
# every second request at 1.15s (phase-locked just under its real window).
API_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Discovery / polling.
DISCOVERY_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=30
CANDIDATE_LIMIT=10
MAX_WATCHED_TOKENS=3

# Early-token universe.
MIN_MARKET_CAP_USD=60000
MAX_MARKET_CAP_USD=3000000
MIN_LIQUIDITY_USD=10000
MAX_TOKEN_AGE_HOURS=24
# token_creation_info is Lite/Starter+, not free Standard. When it is
# inaccessible the age is "unknown": AGE_STRICT=false allows the token
# with a warning, AGE_STRICT=true rejects it.
ENFORCE_TOKEN_AGE=true
AGE_STRICT=false
MAX_PRICE_CHANGE_24H_PERCENT=80

# Smart-money proxy. Birdeye documents these Solana wallet_tags values:
# dev, bundler, sniper, insider, smart_trader.
TOP_TRADERS_LIMIT=10
SMART_TAGS=smart_trader
MIN_SMART_WALLETS=2
MIN_SMART_BUY_RATIO=0.60

# 15m CVD.
CVD_WINDOW_SECONDS=900
CVD_MIN_BUY_SELL_RATIO=1.20

# Paper-position lifecycle only.
STOP_LOSS_PERCENT=15
TAKE_PROFIT_PERCENT=50
MAX_HOLD_SECONDS=2400
# Consecutive bearish-CVD polls before a paper exit fires (whipsaw guard).
BEARISH_EXIT_CONFIRMATIONS=2

# Free keyless enrichment (own polite spacing, outside Birdeye CU budget).
# DexScreener: pool ages (pairCreatedAt) + overview-gap filling.
DEXSCREENER_ENABLED=true
DEXSCREENER_MIN_REQUEST_INTERVAL_SECONDS=0.3
# Jupiter lite Price v3: token-level createdAt age oracle + price fallback.
JUPITER_ENABLED=true
JUPITER_MIN_REQUEST_INTERVAL_SECONDS=0.5

# RugCheck pre-entry veto (free summary endpoint).
RUGCHECK_ENABLED=true
RUGCHECK_MAX_SCORE=50
RUGCHECK_REJECT_DANGER=true
# RUGCHECK_STRICT=true rejects tokens with no report; false allows them.
RUGCHECK_STRICT=false
RUGCHECK_MIN_REQUEST_INTERVAL_SECONDS=0.4

# Optional CabalSpy cluster confirmation. Inert unless a key is set.
CABALSPY_API_KEY=
CABALSPY_ENABLED=true
CABALSPY_MIN_WALLETS=3
# CABALSPY_REQUIRE_CLUSTER=true blocks entries without a cluster.
CABALSPY_REQUIRE_CLUSTER=false
CABALSPY_MIN_REQUEST_INTERVAL_SECONDS=1.0

# Helius RPC + transfers (holder concentration, on-chain buy proof).
# Inert unless HELIUS_API_KEY is set. Prefer the key var below over
# embedding ?api-key= in URLs (URLs end up in logs and process lists).
HELIUS_API_KEY=
HELIUS_ENABLED=true
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_MIN_REQUEST_INTERVAL_SECONDS=0.3
HELIUS_TOP10_MAX_PCT=60
# HELIUS_REJECT_CONCENTRATION=true vetoes entries above the threshold.
HELIUS_REJECT_CONCENTRATION=false
# Verify tagged smart wallets actually bought (advisory helius=N/M log).
HELIUS_VERIFY_WALLETS=true
# HELIUS_REQUIRE_CONFIRMED=true blocks entries with zero confirmed buys.
HELIUS_REQUIRE_CONFIRMED=false
HELIUS_VERIFY_WINDOW_HOURS=24
HELIUS_VERIFY_LIMIT=10
